{
  "name": "magnolia",
  "version": "2.2.0",
  "description": "Open-source qualitative data analysis software",
  "author": {
    "name": "Cale Davis",
    "email": "cale@caledavis.eu"
  },
  "license": "EUPL-1.2",
  "homepage": "https://github.com/caledavis/Magnolia",
  "repository": {
    "type": "git",
    "url": "https://github.com/caledavis/Magnolia.git"
  },
  "bugs": {
    "url": "https://github.com/caledavis/Magnolia/issues"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "vite build",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run && cargo test --workspace",
    "test:watch": "vitest",
    "licenses": "node scripts/build-third-party-licenses.mjs > THIRD-PARTY-LICENSES.txt",
    "icons": "bash scripts/build-icons.sh",
    "downloads": "bash scripts/downloads.sh",
    "release:mac": "node scripts/release.mjs release mac",
    "release:win": "node scripts/release.mjs release win",
    "release:linux": "node scripts/release.mjs release linux",
    "release:finish": "node scripts/release.mjs finish",
    "release:all": "node scripts/release.mjs all",
    "i18n:review-export": "node scripts/translation-review.mjs export",
    "i18n:review-import": "node scripts/translation-review.mjs import",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "layout-check": "node scripts/layout-check/run.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tiptap/extension-color": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-text-style": "^3.35.0",
    "@tiptap/extension-underline": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@types/diff": "^7.0.2",
    "d3-force": "^3.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.5.0",
    "i18next": "26.5.7",
    "jszip": "^3.10.1",
    "lucide-react": "^1.20.0",
    "marked": "^17.0.5",
    "mp4box": "^2.4.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "17.1.5",
    "react-resizable-panels": "^2.1.7",
    "tiptap-markdown": "^0.9.0",
    "uuid": "^14.0.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-force": "^3.0.10",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
